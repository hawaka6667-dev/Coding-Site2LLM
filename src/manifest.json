{
  "manifest_version": 3,
  "name": "Coding Site2LLM",
  "version": "0.5.7.11",
  "description": "Capture coding-site context and send it to an LLM.",
  "icons": {
    "128": "icons/icon128.png"
  },
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "activeTab",
    "webNavigation"
  ],
  "host_permissions": [
    "*://*/*",
    "https://exercism.org/*",
    "https://leetcode.com/*",
    "https://codewars.com/*",
    "https://www.codewars.com/*",
    "https://cr.codewars.com/*",
    "https://chat.deepseek.com/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://deepai.org/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://exercism.org/tracks/*/exercises/*/edit*"
      ],
      "js": [
        "worker/diagnostics.js",
        "worker/exercism/edit/content.js",
        "worker/exercism/edit/auto_submit_after_manual_run.js",
        "worker/exercism/submitted_overview/open_submitted_overview_after_submit.js",
        "worker/exercism/overview/auto_mark_exercise_complete.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://exercism.org/tracks/*/exercises/*"
      ],
      "exclude_matches": [
        "https://exercism.org/tracks/*/exercises/*/edit*"
      ],
      "js": [
        "worker/diagnostics.js",
        "worker/exercism/overview/open_exercise_in_editor.js",
        "worker/exercism/overview/auto_mark_exercise_complete.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": ["*://*/*"],
      "js": [
        "worker/llm_copy_tracker.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*/*"
      ],
      "js": [
        "worker/keyboard_shortcuts.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://sqlbolt.com/lesson/*"
      ],
      "js": [
        "worker/sqlbolt/run_query.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://learncodefast.org/courses/*",
        "https://www.learncodefast.org/courses/*"
      ],
      "js": [
        "worker/learncodefast/course_page_automation.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://exercism.org/tracks/*/concepts*",
        "https://exercism.org/tracks/*/exercises*"
      ],
      "js": [
        "worker/exercism/preserve_track_list_scroll_position.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://exercism.org/tracks/*"
      ],
      "js": [
        "worker/exercism/dismiss_dialogs.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Coding Site2LLM",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
