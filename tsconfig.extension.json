{
  "compilerOptions": {
    "target": "ES2022",
    "module": "preserve",
    "moduleDetection": "legacy",
    "lib": ["ES2022", "DOM"],
    "types": ["chrome"],
    "noImplicitAny": true,
    "strict": false,
    "skipLibCheck": true,
    "rootDir": "src",
    "outDir": "dist",
    "noEmitOnError": true
  },
  "include": ["src/background.ts", "src/worker/**/*.ts", "src/worker/**/*.d.ts"]
}