{
  "manifest_version": 3,
  "name": "Coding Site2LLM",
  "version": "0.3.0",
  "description": "Capture coding-site context and send it to an LLM.",
  "icons": {
    "128": "icons/icon128.png"
  },
  "permissions": [
    "tabs",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://exercism.org/*",
    "https://leetcode.com/*",
    "https://codewars.com/*",
    "https://www.codewars.com/*",
    "https://cr.codewars.com/*",
    "https://chat.deepseek.com/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://deepai.org/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://exercism.org/tracks/*/exercises/*/edit*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://exercism.org/tracks/*/exercises/*"
      ],
      "exclude_matches": [
        "https://exercism.org/tracks/*/exercises/*/edit*"
      ],
      "js": [
        "worker/open_new_exercism_exercise_in_editor.js",
        "worker/auto_mark_exercism_complete.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Coding Site2LLM",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "run-workflow": {
      "suggested_key": {
        "default": "Alt+Q"
      },
      "description": "Send coding-site context to an LLM"
    }
  }
}
